# ── Finance Fox — Umgebungsvariablen ────────────────────────────
# Alle Werte sind optional (Defaults in api/lib/env.ts).
# In Produktion ist mindestens JWT_SECRET zu setzen!

# Session-Secret (HMAC-Signatur der Login-Cookies).
# Unbedingt einen langen zufälligen String wählen!
JWT_SECRET=

# Basis-URL, unter der die App erreichbar ist.
# Wird für Einladungs-/Reset-Links im Server-Log verwendet.
# https:// → Session-Cookie bekommt automatisch das Secure-Flag.
PUBLIC_URL=http://localhost:8080

# Port des Servers (Default: 3000; im docker-compose.yml nach außen 8080)
# PORT=3000

# Ablage der SQLite-Datenbank (Default: file:./data/finance-fox.db;
# im Container: file:/app/data/finance-fox.db → liegt im Volume)
# DATABASE_URL=file:./data/finance-fox.db

# Ablage der Beleg-Anhänge (Bilder/PDF zu Buchungen).
# Default: <Verzeichnis der DATABASE_URL-Datei>/attachments — liegt im
# Docker-Setup damit automatisch im selben Volume, kein Setzen nötig.
# ATTACHMENTS_DIR=./data/attachments

# Secure-Flag des Session-Cookies erzwingen (true|false).
# Default: automatisch anhand von PUBLIC_URL (https → true).
# Bei HTTP-Betrieb im Heimnetz nichts setzen.
# COOKIE_SECURE=false
